# ============================================================
# Secrets / environment
# ============================================================
.env
.env.*
!.env.example
wp-config.php
*.pem
*.key

# ============================================================
# WordPress site (senji-ooo.com)
# Only the custom child theme is tracked. Core, plugins,
# uploads, cache and plugin data (WAF rules, captcha files,
# backup restore data, etc.) are excluded.
# ============================================================
/senji-ooo.com/*
!/senji-ooo.com/wp-content/
/senji-ooo.com/wp-content/*
!/senji-ooo.com/wp-content/themes/
/senji-ooo.com/wp-content/themes/*
!/senji-ooo.com/wp-content/themes/Storefront-child/

# ============================================================
# Data dumps / backups
# (WordPress export XML contains drafts, trash and contact info)
# ============================================================
*.WordPress.*.xml
*.sql
*.sql.gz
*.zip
*.tar
*.tar.gz
*.bak

# ============================================================
# Logs
# ============================================================
*.log

# ============================================================
# OS / editor
# ============================================================
*:Zone.Identifier
.DS_Store
Thumbs.db
.vscode/
.idea/
